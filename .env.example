# Pushover credentials — https://pushover.net
#
# PUSHOVER_USER_KEY is the 30-character "User Key" on your Pushover dashboard.
# PUSHOVER_TOKEN is the API token from an application you register at
# https://pushover.net/apps/build (call it anything, e.g. "Flight Tracker").
#
# Copy this file to .env and fill in the values:  cp .env.example .env

PUSHOVER_USER_KEY=
PUSHOVER_TOKEN=

# Optional: restrict alerts to a single device name from your Pushover account.
# Leave blank to notify every device.
PUSHOVER_DEVICE=

# Optional: use a config file other than ./watches.json
# FLIGHT_TRACKER_CONFIG=/absolute/path/to/watches.json
